{
  "name": "@local/dsh-omni-canvas",
  "version": "0.2.0",
  "description": "DSH plugin: project-scoped infinite canvas that drives a local ComfyUI directly (Qwen-Image 2.1 accelerated text2image / image-edit, H3 director reference-to-video) with a bottom composer and an append-only asset library.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allen-Guo0126/dsh-omni-canvas.git"
  },
  "homepage": "https://github.com/Allen-Guo0126/dsh-omni-canvas#readme",
  "bugs": {
    "url": "https://github.com/Allen-Guo0126/dsh-omni-canvas/issues"
  },
  "author": "Allen-Guo0126",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "comfyui",
    "canvas",
    "ai-video",
    "short-drama",
    "qwen-image",
    "minimax-h3"
  ],
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/",
    "skills/",
    "templates/",
    "locale/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-session": "^0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "check": "node --check lib/index.js && node scripts/check-all.mjs && node scripts/check-imports.mjs && node scripts/check-builtins.mjs && node scripts/prompt-lint-test.mjs && node scripts/prompt-normalize-test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "node scripts/verify-host.mjs",
    "routes": "node scripts/routes-smoke.mjs",
    "boot": "node scripts/boot-smoke.mjs",
    "build:client": "node scripts/bundle-client.mjs",
    "client": "node scripts/bundle-client.mjs && node scripts/client-smoke.mjs",
    "imports": "node scripts/check-imports.mjs",
    "routes:full": "node scripts/routes-full.mjs",
    "builtins": "node scripts/check-builtins.mjs",
    "prompt:lint-test": "node scripts/prompt-lint-test.mjs",
    "prompt:normalize-test": "node scripts/prompt-normalize-test.mjs",
    "resolution:test": "node scripts/resolution-smoke.mjs"
  }
}